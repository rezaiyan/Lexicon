# Fastfile for Lexicon Android deployment automation
# More documentation at https://docs.fastlane.tools

default_platform(:android)

def read_local_prop(key)
  project_root = File.expand_path("..", Dir.pwd)
  local_props_file = File.join(project_root, "local.properties")
  return nil unless File.exist?(local_props_file)
  File.readlines(local_props_file).each do |line|
    if line.strip.start_with?("#{key}=")
      return line.strip.split("=", 2).last.strip
    end
  end
  nil
end

platform :android do
  before_all do
    ensure_git_status_clean unless ENV['CI']
  end

  desc "Build the release AAB"
  lane :build do
    # Decode keystore from base64 secret
    keystore_path = "composeApp/release.keystore"
    sh("echo \"$RELEASE_KEYSTORE_BASE64\" | base64 -d > ../#{keystore_path}")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ".",
      properties: {
        "RELEASE_STORE_FILE" => "release.keystore",
        "RELEASE_STORE_PASSWORD" => ENV["RELEASE_STORE_PASSWORD"],
        "RELEASE_KEY_ALIAS" => ENV["RELEASE_KEY_ALIAS"],
        "RELEASE_KEY_PASSWORD" => ENV["RELEASE_KEY_PASSWORD"],
      }
    )
  end

  desc "Upload a new build to closed testing (alpha track)"
  lane :beta do
    build

    upload_to_play_store(
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      track: "alpha",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and deploy to closed testing locally (uses local service account JSON key file)"
  lane :deploy do
    project_root = File.expand_path("..", Dir.pwd)

    raw_key_path = ENV["GOOGLE_PLAY_JSON_KEY_FILE"] || read_local_prop("GOOGLE_PLAY_JSON_KEY_FILE")
    json_key_file = raw_key_path ? File.expand_path(raw_key_path, project_root) : Dir.glob(File.join(project_root, "vokab-*.json")).first
    UI.user_error!("No service account JSON key file found. Add GOOGLE_PLAY_JSON_KEY_FILE=<path> to local.properties.") unless json_key_file && File.exist?(json_key_file.to_s)

    package_name = ENV["ANDROID_PACKAGE_NAME"] || read_local_prop("ANDROID_PACKAGE_NAME")
    UI.user_error!("No package name found. Add ANDROID_PACKAGE_NAME=<name> to local.properties.") unless package_name

    build

    upload_to_play_store(
      json_key: json_key_file,
      package_name: package_name,
      track: "alpha",
      aab: "composeApp/build/outputs/bundle/release/composeApp-release.aab",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote closed testing build to production"
  lane :release do
    upload_to_play_store(
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      track: "alpha",
      track_promote_to: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception}")
  end
end
