# CocoaPods
# We commit Podfile and Podfile.lock, but ignore the Pods directory
# Run `pod install` to regenerate Pods/
Pods/

# Xcode
xcuserdata/
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
*.xcscmblueprint
*.xccheckout
DerivedData/
# Generated files
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Local secrets overrides (do not commit)
Configuration/Config.secrets.xcconfig
Configuration/Config.private.xcconfig

# macOS
.DS_Store

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Environment files
.env
.env.local

# Bundler
.bundle/
vendor/

# Certificates and profiles
*.p12
*.cer
*.mobileprovision
*.certSigningRequest

# Build archives
*.xcarchive
build/

# App Store Connect API Key
AuthKey_*.p8
