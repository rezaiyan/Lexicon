-- WordEntity table
CREATE TABLE WordEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    originalWord TEXT NOT NULL,
    translation TEXT NOT NULL,
    description TEXT NOT NULL,
    sourceLanguage TEXT NOT NULL,
    targetLanguage TEXT NOT NULL,
    level INTEGER NOT NULL DEFAULT 0,
    easeFactor REAL NOT NULL DEFAULT 2.5,
    interval INTEGER NOT NULL DEFAULT 0,
    repetitions INTEGER NOT NULL DEFAULT 0,
    lastReviewDate INTEGER NOT NULL DEFAULT 0,
    nextReviewDate INTEGER NOT NULL,
    dateAdded INTEGER NOT NULL
);

-- SettingsEntity table
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    languageCode TEXT NOT NULL DEFAULT 'en',
    themeMode TEXT NOT NULL DEFAULT 'AUTO',
    notificationsEnabled INTEGER NOT NULL DEFAULT 1,
    reviewReminders INTEGER NOT NULL DEFAULT 1,
    motivationalMessages INTEGER NOT NULL DEFAULT 1,
    dailyReminderTime TEXT NOT NULL DEFAULT '18:00',
    minimumDueCards INTEGER NOT NULL DEFAULT 5,
    ttsSpeed REAL NOT NULL DEFAULT 1.0,
    ttsSpeakerId INTEGER NOT NULL DEFAULT 0,
    skipTagSelector INTEGER NOT NULL DEFAULT 0,
    word_sync_timestamp INTEGER NOT NULL DEFAULT 0,
    dailyGoalWords INTEGER NOT NULL DEFAULT 10,
    ttsExpressiveness REAL NOT NULL DEFAULT 0.667
);

-- Word queries

insertWord:
INSERT INTO WordEntity(originalWord, translation, description, sourceLanguage, targetLanguage, level, easeFactor, interval, repetitions, lastReviewDate, nextReviewDate, dateAdded)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertWord:
INSERT OR REPLACE INTO WordEntity(id, originalWord, translation, description, sourceLanguage, targetLanguage, level, easeFactor, interval, repetitions, lastReviewDate, nextReviewDate, dateAdded)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllWords:
SELECT * FROM WordEntity;

getDueCards:
SELECT * FROM WordEntity
WHERE nextReviewDate <= ?
ORDER BY
    CASE WHEN lastReviewDate = 0 THEN 0 ELSE 1 END,
    lastReviewDate ASC;

getWordsByLevel:
SELECT * FROM WordEntity
WHERE level = ?
ORDER BY
    CASE WHEN nextReviewDate <= :currentTime THEN 0 ELSE 1 END,
    CASE
        WHEN nextReviewDate <= :currentTime THEN nextReviewDate
        ELSE -lastReviewDate
    END ASC;

getWordById:
SELECT * FROM WordEntity WHERE id = ?;

deleteWord:
DELETE FROM WordEntity WHERE id = ?;

deleteWords:
DELETE FROM WordEntity WHERE id IN ?;

updateWordLanguages:
UPDATE WordEntity SET sourceLanguage = ?, targetLanguage = ? WHERE id IN ?;

countWords:
SELECT count(*) FROM WordEntity;

countDueCards:
SELECT count(*) FROM WordEntity WHERE nextReviewDate <= ?;

getNextDueAt:
SELECT MIN(nextReviewDate) FROM WordEntity WHERE nextReviewDate > ?;

deleteAllWords:
DELETE FROM WordEntity;

lastInsertRowId:
SELECT last_insert_rowid();

getMostCommonSourceLanguage:
SELECT sourceLanguage FROM WordEntity
GROUP BY sourceLanguage
ORDER BY COUNT(*) DESC
LIMIT 1;

-- Settings queries

insertSettings:
INSERT OR REPLACE INTO SettingsEntity(id, languageCode, themeMode, notificationsEnabled, reviewReminders, motivationalMessages, dailyReminderTime, minimumDueCards, ttsSpeed, ttsSpeakerId, skipTagSelector, dailyGoalWords, ttsExpressiveness)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSettings:
SELECT * FROM SettingsEntity WHERE id = 1;

clearSettings:
DELETE FROM SettingsEntity;

getWordSyncTimestamp:
SELECT word_sync_timestamp FROM SettingsEntity WHERE id = 1;

setWordSyncTimestamp:
UPDATE SettingsEntity SET word_sync_timestamp = ? WHERE id = 1;

-- TtsVoicePreference table
CREATE TABLE TtsVoicePreference (
    languageCode TEXT NOT NULL PRIMARY KEY,
    speakerId INTEGER NOT NULL DEFAULT 0,
    numSpeakers INTEGER NOT NULL DEFAULT 1,
    voiceId TEXT
);

-- TtsVoicePreference queries

selectVoicePreferenceForLanguage:
SELECT speakerId, numSpeakers, voiceId FROM TtsVoicePreference WHERE languageCode = ?;

selectAllVoicePreferences:
SELECT languageCode, speakerId, numSpeakers, voiceId FROM TtsVoicePreference;

upsertVoicePreference:
INSERT OR REPLACE INTO TtsVoicePreference(languageCode, speakerId, numSpeakers, voiceId) VALUES (?, ?, ?, ?);

-- TagEntity table
CREATE TABLE TagEntity (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- WordTagEntity table (many-to-many word ↔ tag)
CREATE TABLE WordTagEntity (
    wordId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (wordId, tagId)
);

-- Tag queries

insertOrReplaceTag:
INSERT OR REPLACE INTO TagEntity(id, name, createdAt, updatedAt)
VALUES (?, ?, ?, ?);

-- Counts only links whose word still exists, and (by reading WordEntity) re-emits when words change.
getAllTagsWithWordCount:
SELECT t.id, t.name, t.createdAt, t.updatedAt, COUNT(w.id) AS wordCount
FROM TagEntity t
LEFT JOIN WordTagEntity wt ON t.id = wt.tagId
LEFT JOIN WordEntity w ON w.id = wt.wordId
GROUP BY t.id
ORDER BY t.name ASC;

getTagWordCountsByLevel:
SELECT t.id, t.name, t.createdAt, t.updatedAt, w.level AS level, COUNT(w.id) AS wordCount
FROM TagEntity t
INNER JOIN WordTagEntity wt ON t.id = wt.tagId
INNER JOIN WordEntity w ON wt.wordId = w.id
GROUP BY t.id, w.level
ORDER BY t.name ASC;

getDueTagWordCounts:
SELECT t.id, t.name, t.createdAt, t.updatedAt, COUNT(w.id) AS wordCount
FROM TagEntity t
INNER JOIN WordTagEntity wt ON t.id = wt.tagId
INNER JOIN WordEntity w ON wt.wordId = w.id
WHERE w.nextReviewDate <= :currentTime
GROUP BY t.id
ORDER BY t.name ASC;

deleteTag:
DELETE FROM TagEntity WHERE id = ?;

deleteAllTags:
DELETE FROM TagEntity;

-- WordTag queries

insertWordTag:
INSERT OR IGNORE INTO WordTagEntity(wordId, tagId) VALUES (?, ?);

deleteWordTagsForWord:
DELETE FROM WordTagEntity WHERE wordId = ?;

deleteWordTagsForTag:
DELETE FROM WordTagEntity WHERE tagId = ?;

deleteWordTagsForWords:
DELETE FROM WordTagEntity WHERE wordId IN ?;

deleteAllWordTags:
DELETE FROM WordTagEntity;

countWordTags:
SELECT count(*) FROM WordTagEntity;

getTagIdsForWord:
SELECT tagId FROM WordTagEntity WHERE wordId = ?;

getTagMappingsForWords:
SELECT wordId, tagId FROM WordTagEntity WHERE wordId IN ?;

getDueCardsByTag:
SELECT * FROM WordEntity
WHERE id IN (
    SELECT wordId FROM WordTagEntity WHERE tagId = ?
)
AND nextReviewDate <= ?
ORDER BY
    CASE WHEN lastReviewDate = 0 THEN 0 ELSE 1 END,
    lastReviewDate ASC;

-- ReviewSyncQueue table (persists reviewed word IDs for deferred batch sync)
CREATE TABLE ReviewSyncQueue (
    wordId INTEGER NOT NULL PRIMARY KEY
);

-- ReviewSyncQueue queries

insertReviewSyncEntry:
INSERT OR IGNORE INTO ReviewSyncQueue(wordId) VALUES (?);

getAllReviewSyncEntries:
SELECT wordId FROM ReviewSyncQueue;

clearReviewSyncQueue:
DELETE FROM ReviewSyncQueue;

-- AnalyticsSyncQueue table (persists failed sync requests across app restarts)
CREATE TABLE AnalyticsSyncQueue (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    requestJson TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

-- AnalyticsSyncQueue queries

insertAnalyticsSyncRequest:
INSERT INTO AnalyticsSyncQueue(requestJson, createdAt) VALUES (?, ?);

getAllAnalyticsSyncRequests:
SELECT id, requestJson FROM AnalyticsSyncQueue ORDER BY createdAt ASC;

clearAnalyticsSyncQueue:
DELETE FROM AnalyticsSyncQueue;

-- Progress stats aggregate query

progressRow:
SELECT
    COALESCE(SUM(CASE WHEN level = 0 THEN 1 ELSE 0 END), 0) AS level0Count,
    COALESCE(SUM(CASE WHEN level = 1 THEN 1 ELSE 0 END), 0) AS level1Count,
    COALESCE(SUM(CASE WHEN level = 2 THEN 1 ELSE 0 END), 0) AS level2Count,
    COALESCE(SUM(CASE WHEN level = 3 THEN 1 ELSE 0 END), 0) AS level3Count,
    COALESCE(SUM(CASE WHEN level = 4 THEN 1 ELSE 0 END), 0) AS level4Count,
    COALESCE(SUM(CASE WHEN level = 5 THEN 1 ELSE 0 END), 0) AS level5Count,
    COALESCE(SUM(CASE WHEN level = 6 THEN 1 ELSE 0 END), 0) AS level6Count,
    COUNT(*) AS totalWords,
    COALESCE(SUM(CASE WHEN nextReviewDate <= :currentTime THEN 1 ELSE 0 END), 0) AS dueCards
FROM WordEntity;

-- WordRushPendingGames table (offline queue for Word Rush game results)
CREATE TABLE WordRushPendingGames (
    client_game_id    TEXT    NOT NULL PRIMARY KEY,
    score             INTEGER NOT NULL,
    total_questions   INTEGER NOT NULL,
    correct_count     INTEGER NOT NULL,
    best_streak       INTEGER NOT NULL,
    duration_ms       INTEGER NOT NULL,
    avg_response_ms   INTEGER NOT NULL,
    grade             TEXT    NOT NULL,
    lives_remaining   INTEGER NOT NULL,
    completed_normally INTEGER NOT NULL,
    played_at         INTEGER NOT NULL
);

-- WordRushPendingGames queries

insertWordRushPendingGame:
INSERT OR IGNORE INTO WordRushPendingGames VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllWordRushPendingGames:
SELECT * FROM WordRushPendingGames;

deleteAllWordRushPendingGames:
DELETE FROM WordRushPendingGames;

-- ListeningPendingSessions table (offline queue for listening sessions; payload is the sync JSON)
CREATE TABLE ListeningPendingSessions (
    client_session_id TEXT    NOT NULL PRIMARY KEY,
    request_json      TEXT    NOT NULL,
    created_at        INTEGER NOT NULL
);

insertListeningPendingSession:
INSERT OR IGNORE INTO ListeningPendingSessions VALUES (?, ?, ?);

selectAllListeningPendingSessions:
SELECT * FROM ListeningPendingSessions ORDER BY created_at ASC;

deleteListeningPendingSessions:
DELETE FROM ListeningPendingSessions WHERE client_session_id IN ?;

-- LearningFocusEntity: single-row, client-only learning focus preference.
-- Separate table on purpose: insertSettings is INSERT OR REPLACE with an explicit
-- column list, so extra SettingsEntity columns would be reset on every settings save.
CREATE TABLE LearningFocusEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    focusCode TEXT,
    nudgeDismissedDay INTEGER,
    introAcknowledged INTEGER NOT NULL DEFAULT 0
);

getLearningFocus:
SELECT * FROM LearningFocusEntity WHERE id = 1;

ensureLearningFocusRow:
INSERT OR IGNORE INTO LearningFocusEntity(id) VALUES (1);

setLearningFocusCode:
UPDATE LearningFocusEntity SET focusCode = ? WHERE id = 1;

setLearningFocusNudgeDismissedDay:
UPDATE LearningFocusEntity SET nudgeDismissedDay = ? WHERE id = 1;

setLearningFocusIntroAcknowledged:
UPDATE LearningFocusEntity SET introAcknowledged = 1 WHERE id = 1;

clearLearningFocus:
DELETE FROM LearningFocusEntity;

-- FeatureAccessCache: single-row, last feature-access response from the backend (JSON).
-- Lets the app start with the user's real premium state when offline; cleared on logout.
CREATE TABLE FeatureAccessCache (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    json TEXT NOT NULL
);

getFeatureAccessCache:
SELECT json FROM FeatureAccessCache WHERE id = 1;

saveFeatureAccessCache:
INSERT OR REPLACE INTO FeatureAccessCache(id, json) VALUES (1, ?);

clearFeatureAccessCache:
DELETE FROM FeatureAccessCache;

-- ListeningSettingsEntity: single-row, client-only listening mode preferences.
-- Separate table for the same reason as LearningFocusEntity (insertSettings column list).
CREATE TABLE ListeningSettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    pauseMs INTEGER NOT NULL DEFAULT 3000,
    listeningOrder TEXT NOT NULL DEFAULT 'WORD_FIRST',
    repeatCount INTEGER NOT NULL DEFAULT 1,
    -- Which words to play: DUE, ALL, LEVEL:<level> or TAG:<tagId>.
    sourceKey TEXT NOT NULL DEFAULT 'DUE',
    -- Words per session; 0 plays every matching word.
    wordLimit INTEGER NOT NULL DEFAULT 20,
    shuffle INTEGER NOT NULL DEFAULT 0
);

getListeningSettings:
SELECT * FROM ListeningSettingsEntity WHERE id = 1;

saveListeningSettings:
INSERT OR REPLACE INTO ListeningSettingsEntity(id, pauseMs, listeningOrder, repeatCount, sourceKey, wordLimit, shuffle)
VALUES (1, ?, ?, ?, ?, ?, ?);

clearListeningSettings:
DELETE FROM ListeningSettingsEntity;

-- Add-words pipeline ---------------------------------------------------------

CREATE INDEX IF NOT EXISTS WordEntity_targetLanguage ON WordEntity(targetLanguage);

-- Term/translation of every word in one learning language, for duplicate checks on add.
getWordIdentitiesForLanguage:
SELECT originalWord, translation FROM WordEntity WHERE targetLanguage = ?;

getWordsByIds:
SELECT * FROM WordEntity WHERE id IN ?;

-- WordUploadQueue: locally added words not yet confirmed by the server (offline-first outbox).
CREATE TABLE WordUploadQueue (
    wordId INTEGER NOT NULL PRIMARY KEY
);

enqueueWordUpload:
INSERT OR IGNORE INTO WordUploadQueue(wordId) VALUES (?);

getWordUploadQueue:
SELECT wordId FROM WordUploadQueue;

removeWordUploads:
DELETE FROM WordUploadQueue WHERE wordId IN ?;

clearWordUploadQueue:
DELETE FROM WordUploadQueue;

-- Re-keying a word to its server id once uploaded (local id = server id for every synced word).
maxWordId:
SELECT MAX(id) FROM WordEntity;

moveWordUpload:
UPDATE OR IGNORE WordUploadQueue SET wordId = :newId WHERE wordId = :oldId;

changeWordId:
UPDATE WordEntity SET id = :newId WHERE id = :oldId;

moveWordTags:
UPDATE OR IGNORE WordTagEntity SET wordId = :newId WHERE wordId = :oldId;

moveReviewSyncEntry:
UPDATE OR IGNORE ReviewSyncQueue SET wordId = :newId WHERE wordId = :oldId;

removeReviewSyncEntry:
DELETE FROM ReviewSyncQueue WHERE wordId = ?;

-- AddWordsPreferenceEntity: single-row, client-only. Language pair last used when adding words.
CREATE TABLE AddWordsPreferenceEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    learningLanguage TEXT NOT NULL,
    nativeLanguage TEXT NOT NULL
);

getAddWordsPreference:
SELECT learningLanguage, nativeLanguage FROM AddWordsPreferenceEntity WHERE id = 1;

saveAddWordsPreference:
INSERT OR REPLACE INTO AddWordsPreferenceEntity(id, learningLanguage, nativeLanguage) VALUES (1, ?, ?);

clearAddWordsPreference:
DELETE FROM AddWordsPreferenceEntity;

-- Most frequent (learning, native) pair across the collection.
getMostCommonLanguagePair:
SELECT targetLanguage, sourceLanguage FROM WordEntity
WHERE targetLanguage != sourceLanguage
GROUP BY targetLanguage, sourceLanguage
ORDER BY COUNT(*) DESC
LIMIT 1;

-- Insights coach: last server screen as raw JSON (single row, id = 1)
CREATE TABLE InsightsScreenCache (
    id            INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    json          TEXT    NOT NULL,
    fetched_at_ms INTEGER NOT NULL
);

getInsightsScreenCache:
SELECT json, fetched_at_ms FROM InsightsScreenCache WHERE id = 1;

saveInsightsScreenCache:
INSERT OR REPLACE INTO InsightsScreenCache(id, json, fetched_at_ms) VALUES (1, ?, ?);

clearInsightsScreenCache:
DELETE FROM InsightsScreenCache;

-- Insights coach: card ids the user dismissed today
CREATE TABLE DismissedCoachCard (
    card_id TEXT NOT NULL PRIMARY KEY
);

selectDismissedCoachCards:
SELECT card_id FROM DismissedCoachCard;

insertDismissedCoachCard:
INSERT OR IGNORE INTO DismissedCoachCard(card_id) VALUES (?);

-- Card ids end with ":<local date>"; keep only today's.
pruneDismissedCoachCards:
DELETE FROM DismissedCoachCard WHERE card_id NOT LIKE '%:' || ?;

clearDismissedCoachCards:
DELETE FROM DismissedCoachCard;
