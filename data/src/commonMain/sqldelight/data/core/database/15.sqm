-- Migration from version 15 to version 16
-- Listening mode preferences (pause length, read order, repeats). Single row, client-only.
CREATE TABLE IF NOT EXISTS ListeningSettingsEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    pauseMs INTEGER NOT NULL DEFAULT 3000,
    listeningOrder TEXT NOT NULL DEFAULT 'WORD_FIRST',
    repeatCount INTEGER NOT NULL DEFAULT 1
);
