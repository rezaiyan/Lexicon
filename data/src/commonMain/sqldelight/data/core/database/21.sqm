-- Migration from version 21 to version 22
-- Support chat messages (see SupportMessageEntity in Lexicon.sq).
CREATE TABLE IF NOT EXISTS SupportMessageEntity (
    localId   TEXT    NOT NULL PRIMARY KEY,
    serverId  INTEGER UNIQUE,
    sender    TEXT    NOT NULL,
    body      TEXT    NOT NULL,
    createdAt INTEGER NOT NULL,
    status    TEXT    NOT NULL
);
